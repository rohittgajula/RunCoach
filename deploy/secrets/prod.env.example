# Template for deploy/secrets/prod.env (git-ignored). Copy, fill in, then run
#   deploy/scripts/push-secrets.sh deploy@<server-ip> --restart
# Every key becomes the Kubernetes Secret `runcoach-secrets`, loaded into the
# backend and both workers (and POSTGRES_* into Postgres and the backup job).
# Rules: KEY=value, no quotes, no spaces around "=", one per line.
# Contract: docs/DEPLOY.md §1.

# --- Django ---------------------------------------------------------------------
DJANGO_DEBUG=0
# 64+ random chars, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=runcoach.rohitgajula.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://runcoach.rohitgajula.in
CORS_ALLOWED_ORIGINS=https://runcoach.rohitgajula.in
DJANGO_SECURE=1
TRUST_CF_CONNECTING_IP=1
# open | invite | closed
REGISTRATION_MODE=invite
LOG_LEVEL=INFO

# --- Postgres (also creates the database on first start) -----------------------
# Changing POSTGRES_PASSWORD later does NOT change it inside an existing
# database; see "Rotate secrets" in docs/DEPLOY.md.
POSTGRES_DB=runcoach
POSTGRES_USER=runcoach
# e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- AI -------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_LITE_MODEL=
AI_FAST_MODEL=
AI_COACH_MODEL=
AI_DEEP_MODEL=
AI_TIMEOUT_SEC=60
AI_MAX_RETRIES=2
# Per athlete per month (the admin page can set a different one per user).
AI_MONTHLY_CALL_BUDGET=400
# R14: Google AI Studio key. Enables the Gemini provider on the admin page (tiers can
# then be switched to Gemini there). Entered with a hidden prompt (read -rs) straight
# into prod.env — never echoed, never in shell history. Empty = Gemini hidden.
GEMINI_API_KEY=

# --- Admin page: GCP free trial card (R14 §14) -------------------------------------
# Shown on /admin-panel → System only. Date YYYY-MM-DD; credit in rupees.
GCP_TRIAL_END=2027-01-03
GCP_CREDIT_INR=
# Optional: the app version shown there (the Kubernetes image tag is used otherwise).
# GIT_SHA=

# --- Media ------------------------------------------------------------------------
SIGNED_MEDIA_TTL_SEC=3600

# --- Set by the runcoach-config ConfigMap (deploy/k8s/base/config.yaml) -----------
# Uncomment only to override; a value here wins over the ConfigMap.
# POSTGRES_HOST=postgres
# POSTGRES_PORT_INTERNAL=5432
# REDIS_URL=redis://redis:6379/0
# MEDIA_ROOT=/app/media
# GARMIN_TOKEN_DIR=/app/.garmin

# --- Web push reminders (R10) -------------------------------------------------------
# All three, or the Reminders feature hides itself. Generate the pair once with the
# one-liner in docs/API_NOTES.md (R10 §C12); never rotate casually — every browser
# subscription is tied to the public key and would have to subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact the push services can reach, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Optional: seconds between the once-a-day slow Garmin calls (default 1.5).
# GARMIN_SLOW_PAUSE_S=1.5
