# Template for deploy/secrets/prod.env (git-ignored). Copy, fill in, then run
#   deploy/scripts/push-secrets.sh deploy@<server-ip> --restart
# Every key becomes the Kubernetes Secret `runcoach-secrets`, loaded into the
# backend and both workers (and POSTGRES_* into Postgres and the backup job).
# Rules: KEY=value, no quotes, no spaces around "=", one per line.
# Contract: docs/DEPLOY.md §1.

# --- Django ---------------------------------------------------------------------
DJANGO_DEBUG=0
# 64+ random chars, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=runcoach.rohitgajula.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://runcoach.rohitgajula.in
CORS_ALLOWED_ORIGINS=https://runcoach.rohitgajula.in
DJANGO_SECURE=1
TRUST_CF_CONNECTING_IP=1
# open | invite | closed
REGISTRATION_MODE=invite
LOG_LEVEL=INFO

# --- Postgres (also creates the database on first start) -----------------------
# Changing POSTGRES_PASSWORD later does NOT change it inside an existing
# database; see "Rotate secrets" in docs/DEPLOY.md.
POSTGRES_DB=runcoach
POSTGRES_USER=runcoach
# e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- AI -------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_LITE_MODEL=
AI_FAST_MODEL=
AI_COACH_MODEL=
AI_DEEP_MODEL=
AI_TIMEOUT_SEC=60
AI_MAX_RETRIES=2
# Per athlete per month.
AI_MONTHLY_CALL_BUDGET=400
# Only if AI_PROVIDER=gemini
GEMINI_API_KEY=

# --- Media ------------------------------------------------------------------------
SIGNED_MEDIA_TTL_SEC=3600

# --- Set by the runcoach-config ConfigMap (deploy/k8s/base/config.yaml) -----------
# Uncomment only to override; a value here wins over the ConfigMap.
# POSTGRES_HOST=postgres
# POSTGRES_PORT_INTERNAL=5432
# REDIS_URL=redis://redis:6379/0
# MEDIA_ROOT=/app/media
# GARMIN_TOKEN_DIR=/app/.garmin
