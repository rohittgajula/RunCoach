# Optional: copy to deploy/secrets/r2.env (git-ignored) to also upload each nightly
# backup to Cloudflare R2. Create an R2 bucket and an API token with Object
# Read & Write on that bucket only. Set a lifecycle rule on the bucket to expire
# old objects (e.g. 30 days). No quotes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=runcoach-backups
