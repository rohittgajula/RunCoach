# Secrets — never commit
.env
.env.local
*.pem
*.key
garmin_tokens.json
oauth1_token.json
oauth2_token.json
# Garmin session tokens (per-athlete directories)
.garmin/
# kubeconfig files grant full control of a cluster
kubeconfig*
*.kubeconfig
# Server credentials
deploy/secrets/*
!deploy/secrets/*.example

# OS / editor
.DS_Store
.idea/
.vscode/

