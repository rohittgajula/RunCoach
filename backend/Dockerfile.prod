# Production image for the Django API and the Celery workers (same image, different
# command). Development keeps using ./Dockerfile via docker-compose.
#
#   docker buildx build --platform linux/amd64 -f backend/Dockerfile.prod backend

# --- build: compile wheels into a venv -----------------------------------------
FROM python:3.12-slim AS build

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install -r requirements.txt

# --- runtime ---------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    DJANGO_DEBUG=0 \
    MEDIA_ROOT=/app/media \
    GARMIN_TOKEN_DIR=/app/.garmin

# Fixed uid/gid so the Kubernetes securityContext (runAsUser/fsGroup 10001) matches.
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --chown=app:app . .

# Static files are baked in at build time (served by WhiteNoise). The key below is
# a throwaway that exists only for this command; the real one comes from the
# runcoach-secrets Secret at runtime.
RUN DJANGO_SECRET_KEY="collectstatic-only-$(python -c 'import secrets;print(secrets.token_hex(48))')" \
    DJANGO_ALLOWED_HOSTS=localhost \
    python manage.py collectstatic --noinput \
 && mkdir -p /app/media /app/.garmin \
 && chown -R app:app /app/media /app/.garmin /app/staticfiles

USER 10001:10001
EXPOSE 8000

# Chat turns and Garmin pushes can take >30 s, hence the long timeout.
CMD ["gunicorn", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "2", \
     "--timeout", "150", \
     "--worker-tmp-dir", "/dev/shm", \
     "--forwarded-allow-ips", "*", \
     "--access-logfile", "-"]
